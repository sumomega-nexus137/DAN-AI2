# Скопируйте этот файл в .env и заполните значения:  cp .env.example .env
#
# ВАЖНО: .env уже в .gitignore и НИКОГДА не коммитится.
# На хостинге (Hugging Face Spaces → Settings → Variables and secrets,
# Render → Environment) ключи задаются через панель секретов, а не в коде.

# ─── Ключи ──────────────────────────────────────────────────────────────────

# Google Gemini API key. Нужен ТОЛЬКО Telegram-боту для голосовых сообщений:
# аудио уходит напрямую в Gemini Flash, своего распознавания речи в проекте нет.
# Backend и сайт работают и без него.
# Получить: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Токен Telegram-бота, получить у @BotFather. Нужен только боту.
TELEGRAM_BOT_TOKEN=

# ─── Связь между частями ────────────────────────────────────────────────────

# Адрес backend'а — его читает Telegram-бот
BACKEND_URL=http://localhost:8000

# Адрес backend'а для веб-интерфейса (читается при сборке Vite, префикс VITE_
# обязателен). Оставьте пустым/не задавайте, если backend раздаёт сайт сам —
# тогда фронт ходит на тот же origin.
# VITE_BACKEND_URL=http://localhost:8000

# ─── Модель и производительность (менять не обязательно) ────────────────────

# Демо-режим: не грузить DINOv2, отдавать заготовленный ответ.
# Удобно для разработки фронтенда и для показа без весов модели.
DEMO_MODE=0

# Папка с обученными головами-классификаторами (*.pkl)
# MODELS_DIR=./models

# Папка со сборкой сайта, которую раздаёт backend
# WEBAPP_DIST=./webapp/dist

# Бэкбон DINOv2 (веса скачиваются автоматически при первом запуске)
# DINOV2_MODEL=dinov2_vits14

# Бюджет времени на прогон зёрен через модель, секунды (требование: ответ < 5 с)
INFERENCE_TIME_BUDGET_S=3.5

# Потолок числа зёрен, реально прогоняемых через DINOv2 с одного фото.
# 120 — компромисс скорость/точность долей (подвыборка равномерна по кадру).
MAX_GRAINS_PER_IMAGE=120

# Максимальный размер загружаемого фото, байты (12 МБ)
# MAX_UPLOAD_BYTES=12582912

# ─── Цены пшеницы для расчёта экономики, тенге за тонну ─────────────────────
# Вилка «от и до» по классам. Рынок меняется — правьте здесь, пересборка не нужна.

PRICE_CLASS_3_MIN_KZT=90000
PRICE_CLASS_3_MAX_KZT=115000
PRICE_CLASS_4_MIN_KZT=80000
PRICE_CLASS_4_MAX_KZT=90000
PRICE_CLASS_5_MIN_KZT=70000
PRICE_CLASS_5_MAX_KZT=80000

# Фуражное зерно — если партия не проходит даже 5 класс
PRICE_FODDER_MIN_KZT=50000
PRICE_FODDER_MAX_KZT=60000
